# Required for auto-highlight mode (picking the best moments from a transcript)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
CLIP_MODEL=claude-haiku-4-5-20251001
CLIP_STORAGE_DIR=./data/clips
CLIP_RETENTION_HOURS=48
PORT=8000

# Optional: route YouTube requests through a proxy (e.g. a residential proxy
# provider) if the host's own IP gets rate-limited/blocked by YouTube.
# Format: http://user:pass@host:port
YTDLP_PROXY=

# Optional: paste the full contents of a Netscape-format cookies.txt file
# (exported from a browser logged into YouTube -- use a secondary/throwaway
# account, not your main one, since this grants session-level access) to
# authenticate yt-dlp as a real logged-in session. Significantly reduces
# YouTube serving throttled/degraded video streams to proxy traffic.
YTDLP_COOKIES_CONTENT=
